# ===========================================================================
# DATA COMMONS AGENT — DEPLOYMENT CONFIGURATION
# ===========================================================================
#
# This repository is ONE deployment. Clone it again for a second one; do not
# try to run two from one checkout.
#
#   $EDITOR config/instance.env          <- you are here
#   GEMINI_API_KEY=... ./deploy.sh --bootstrap-secrets
#   ./deploy.sh
#
# NO SECRETS IN THIS FILE, ever. The Gemini key goes to Secret Manager via
# --bootstrap-secrets, which reads it from your shell and writes nothing to
# disk.
# ===========================================================================


# ── 1. Where it runs ───────────────────────────────────────────────────────

# Your GCP project id. Billing must be enabled on it.
PROJECT_ID=""

# Region for Cloud Run, the buckets and Artifact Registry. Use the same region
# as your DCP service unless you have a reason not to.
#   e.g. us-central1 · europe-west1 · asia-south1
REGION=""

# Short name for this deployment. Lowercase, DNS-safe. Names every resource,
# so two deployments in one project stay separate.
INSTANCE=""


# ── 2. Your DCP data plane ─────────────────────────────────────────────────
#
# Both values come from the datacommons-cli scaffold that provisioned your DCP
# instance:
#
#   terraform output datacommons_service_url
#   terraform output datacommons_service_name
#
# The NAME matters as much as the URL: it is what this agent's service account
# is granted run.invoker on. Without that grant the backend refuses every call,
# and it shows up as "no data" in answers rather than as an error anywhere.
DCP_SERVICE_URL=""
DCP_SERVICE_NAME=""

# Set to "true" only if your DCP service is ingress=internal. It routes ALL of
# the agent's outbound traffic through a VPC, which is what reaching an
# internal service requires — and which needs Cloud NAT if the agent must also
# reach any non-Google host.
ENABLE_VPC_EGRESS="false"


# ── 3. Who can reach it ────────────────────────────────────────────────────
#
#   public   Anyone with the URL. This includes the chat endpoint, so it
#            spends your Gemini quota on every request from anyone. If your
#            front end is a public website, this is what you need — pair it
#            with a tight ALLOWED_ORIGIN, or put your own backend in front.
#   iap      Google sign-in in front of the agent. Only AUTHORIZED_MEMBERS get
#            in. Requires an OAuth consent screen in the project — one manual
#            console step, once. A browser front end cannot call this without
#            carrying the user's credential.
#   private  No public access and no sign-in. Reach it only through
#            `gcloud run services proxy`. Good for a pilot you drive yourself.
#
# If your organisation enforces Domain Restricted Sharing, "public" will be
# refused and you want "iap".
ACCESS_MODE=""

# Comma-separated, each entry prefixed user: or group:.
# Required for "iap" and "private". Leave empty for "public".
#   e.g. group:data-team@acme.com,user:ana@acme.com
AUTHORIZED_MEMBERS=""

# Which origins may call the agent from a browser. Comma-separated.
#
# Required. This service has no UI of its own, so every caller is cross-origin
# and this list is the only thing stopping an arbitrary website from driving
# your agent and spending your Gemini quota.
#   e.g. https://data.acme.com,https://staging.acme.com
# "*" works, and is a decision rather than a default.
ALLOWED_ORIGIN=""


# ── 4. Optional ────────────────────────────────────────────────────────────

# IANA timezone used when the agent renders {{CURRENT_DATETIME}} into prompts.
#   e.g. Asia/Kolkata · America/New_York · UTC
TIMEZONE="UTC"

# Defaults to <PROJECT_ID>-<INSTANCE>-config. Set only to keep an existing
# deployment pointed at a bucket it already uses.
#CONFIG_BUCKET=""

# Defaults to <PROJECT_ID>-tfstate. Holds Terraform state; keep versioning on.
#STATE_BUCKET=""

# Artifact Registry repository for the agent image. Created if absent.
AR_REPO="dc-agent"
